/* ===== Лок email після підтвердження (спан + галочка + карандаш) ===== */
function checkoutLockEmail(email) {
    var $input = $('#collapse-payment-address input[name="email"]');
    if (!$input.length) return;

    $input.val(email);
    var $field = $input.closest('.checkout-field');
    $field.removeClass('has-error');
    $field.find('.text-danger').remove();

    // ховаємо інпут, але лишаємо в DOM — щоб значення пішло в POST
    $input.hide();

    if ($field.find('.checkout-email-locked').length) {
        $field.find('.cel-email').text(email);
        return;
    }

    var $lock = $(
        '<div class="checkout-email-locked">' +
            '<svg class="cel-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>' +
            '<span class="cel-email"></span>' +
            '<button type="button" class="cel-edit" aria-label="Змінити email" title="Змінити email">' +
                '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>' +
            '</button>' +
        '</div>'
    );
    $lock.find('.cel-email').text(email);
    $field.append($lock);
}

function checkoutUnlockEmail() {
    var $input = $('#collapse-payment-address input[name="email"]');
    if (!$input.length) return;

    $input.closest('.checkout-field').find('.checkout-email-locked').remove();
    $input.show();
    setTimeout(function() { $input.trigger('focus'); }, 30);

    // скидаємо підтвердження на сервері — редагування вимагає нового коду
    $.ajax({ url: 'index.php?route=checkout/register/clearVerify', type: 'post' });
}

$(document).on('click', '.cel-edit', function() {
    checkoutUnlockEmail();
});

/* ===== Реєстрація на checkout: підтвердження email кодом ===== */
var checkoutOtpResendTimer = null;

function checkoutOtpClose() {
    $('#checkout-otp-modal').removeClass('is-open');
    if (checkoutOtpResendTimer) { clearInterval(checkoutOtpResendTimer); checkoutOtpResendTimer = null; }
}

function checkoutOtpError(msg) {
    $('#checkout-otp-error').text(msg || '').toggle(!!msg);
}

function checkoutOtpStartResendTimer() {
    var $btn = $('#checkout-otp-resend');
    var left = 45;
    $btn.prop('disabled', true);
    var tick = function() {
        $btn.text('Надіслати ще раз' + (left > 0 ? ' (' + left + ')' : ''));
        if (left <= 0) { $btn.prop('disabled', false); clearInterval(checkoutOtpResendTimer); checkoutOtpResendTimer = null; }
        left--;
    };
    tick();
    checkoutOtpResendTimer = setInterval(tick, 1000);
}

function checkoutOtpSend(email, onSent) {
    var $step = $('#collapse-payment-address');
    checkoutOtpError('');
    $.ajax({
        url: 'index.php?route=checkout/register/sendCode',
        type: 'post',
        data: {
            email: email,
            firstname: $.trim($step.find('input[name="firstname"]').val()),
            telephone: $.trim($step.find('input[name="telephone"]').val())
        },
        dataType: 'json',
        success: function(json) {
            if (json['success']) {
                if (typeof onSent === 'function') onSent();
            } else {
                checkoutOtpError(json['error'] || 'Не вдалося надіслати код.');
            }
        },
        error: function() { checkoutOtpError('Помилка з’єднання. Спробуйте ще раз.'); }
    });
}

function checkoutOtpFlow(email, onVerified) {
    checkoutOtpSend(email, function() {
        $('#checkout-otp-email').text(email);
        $('#checkout-otp-code').val('');
        checkoutOtpError('');
        $('#checkout-otp-modal').addClass('is-open').data('email', email).data('onverified', onVerified);
        checkoutOtpStartResendTimer();
        setTimeout(function() { $('#checkout-otp-code').trigger('focus'); }, 50);
    });
}

$(document).on('click', '#checkout-otp-close, #checkout-otp-modal .checkout-otp__backdrop', function() {
    checkoutOtpClose();
});

$(document).on('click', '#checkout-otp-resend', function() {
    var email = $('#checkout-otp-modal').data('email');
    checkoutOtpSend(email, function() { checkoutOtpStartResendTimer(); });
});

$(document).on('submit', '#checkout-otp-form', function(e) {
    e.preventDefault();
    var $modal = $('#checkout-otp-modal');
    var email = $modal.data('email');
    var code = $.trim($('#checkout-otp-code').val());
    var onVerified = $modal.data('onverified');

    if (!code) { checkoutOtpError('Введіть код з листа.'); return; }

    var $btn = $('#checkout-otp-submit');
    $btn.prop('disabled', true);
    checkoutOtpError('');

    $.ajax({
        url: 'index.php?route=checkout/register/verifyCode',
        type: 'post',
        data: { email: email, code: code },
        dataType: 'json',
        success: function(json) {
            $btn.prop('disabled', false);
            if (json['success']) {
                checkoutOtpClose();
                if (typeof onVerified === 'function') onVerified();
            } else {
                checkoutOtpError(json['error'] || 'Невірний код.');
            }
        },
        error: function() { $btn.prop('disabled', false); checkoutOtpError('Помилка з’єднання. Спробуйте ще раз.'); }
    });
});
//--></script>

<div id="checkout-otp-modal" class="checkout-otp">
    <div class="checkout-otp__backdrop"></div>
    <div class="checkout-otp__dialog" role="dialog" aria-modal="true">
        <button type="button" id="checkout-otp-close" class="checkout-otp__close" aria-label="Закрити">&times;</button>
        <h3 class="checkout-otp__title">Підтвердьте email</h3>
        <p class="checkout-otp__note">Ми надіслали код підтвердження на <b id="checkout-otp-email"></b>. Введіть його, щоб завершити реєстрацію та перейти до оплати.</p>
        <form id="checkout-otp-form">
            <input type="text" id="checkout-otp-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" class="form-input" placeholder="Код з листа">
            <div id="checkout-otp-error" class="checkout-otp__error" style="display:none;"></div>
            <button type="submit" id="checkout-otp-submit" class="btn checkout-otp__submit">Підтвердити</button>
            <button type="button" id="checkout-otp-resend" class="checkout-otp__resend">Надіслати ще раз</button>
        </form>
    </div>
</div>

