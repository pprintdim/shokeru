<section class="aboutHero">
    <div class="aboutHero__media" aria-hidden="true">
        {% if video %}
            <video class="aboutHero__video" autoplay muted loop playsinline preload="metadata"
                {% if poster %}poster="{{ poster }}"{% endif %}>
                {% if video_mob %}<source src="{{ video_mob }}" media="(max-width: 639px)" type="video/mp4">{% endif %}
                <source src="{{ video }}" type="video/mp4">
            </video>
        {% endif %}
    </div>
    <div class="aboutHero__overlay" aria-hidden="true"></div>

    <svg class="aboutHero__arc aboutHero__arc--1" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M40 20 L70 80 L50 90 L100 180" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <svg class="aboutHero__arc aboutHero__arc--2" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M160 30 L130 90 L150 100 L100 180" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

    <div class="container">
        <div class="aboutHero__inner">
            <ul class="breadcrumbs aboutHero__crumbs">
                <li><a href="{{ base }}">{{ text_home ?: 'Головна' }}</a></li>
                <li><a href="#" class="active">{{ text_about ?: 'Про нас' }}</a></li>
            </ul>

            <span class="aboutHero__eyebrow">{{ text_eyebrow ?: 'Оригінал • сертифіковано' }}</span>

            <h1 class="aboutHero__title">{{ hero_title|raw }}</h1>

            {% if lead %}
                <p class="aboutHero__lead">{{ lead }}</p>
            {% endif %}
            {% if content %}
                <button type="button" class="aboutHero__more" data-about-open>
                    {{ button_more ?: 'Детальніше' }}
                    <svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M5.1665 12.0002L9.1665 8.00016L5.1665 4.00016L6.49984 2.66683L11.8332 8.00016L6.49984 13.3335L5.1665 12.0002Z" fill="currentColor"/></svg>
                </button>
            {% endif %}

            {% if stats %}
                <dl class="aboutus__block aboutHero__stats">
                    {% for stat in stats %}
                        {% if stat.value or stat.label %}
                            <div class="aboutHero__stat">
                                <dt><span>{{ stat.value }}{% if stat.suffix %}<span class="aboutHero__suffix">{{ stat.suffix }}</span>{% endif %}</span></dt>
                                <dd>{{ stat.label }}</dd>
                            </div>
                        {% endif %}
                    {% endfor %}
                </dl>
            {% endif %}

            {% if cards %}
                <div class="aboutus__box aboutHero__cards">
                    {% for card in cards %}
                        {% if card.title or card.accent %}
                            <div class="aboutus__box-item">
                                <h4 class="aboutus__box-title">
                                    {{ text_rating ?: 'Рейтинг' }}
                                    <span>{{ card.title }}</span>
                                </h4>
                                <div class="aboutus__box-bottom">
                                    <span class="aboutus__box-icons">//////////</span>
                                    <a class="aboutus__box-btn" href="{{ catalog_href }}">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M4.6665 12.0002L8.6665 8.00016L4.6665 4.00016L5.99984 2.66683L11.3332 8.00016L5.99984 13.3335L4.6665 12.0002Z" fill="currentColor"/></svg>
                                    </a>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</section>

{% if content %}
<div class="aboutModal" data-about-modal hidden>
    <div class="aboutModal__backdrop" data-about-close></div>
    <div class="aboutModal__dialog" role="dialog" aria-modal="true" aria-label="{{ text_about ?: 'Про нас' }}">
        <button type="button" class="aboutModal__close" data-about-close aria-label="{{ button_close ?: 'Закрити' }}">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><line x1="1" y1="1" x2="17" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="17" y1="1" x2="1" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <div class="aboutModal__content">{{ content|raw }}</div>
    </div>
</div>
{% endif %}
