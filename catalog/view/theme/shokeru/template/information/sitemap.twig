{{ header }}
{{ content_top }}
<section class="sitemap">
    <div class="container">
        <div class="sitemap__inner">
            {% if breadcrumbs %}<ul class="breadcrumbs">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}"{% if loop.last %} class="active"{% endif %}>{{ breadcrumb.text }}</a></li>{% endfor %}</ul>{% endif %}
            <h1 class="sitemap__title main-title">{{ heading_title }}</h1>

            <div class="sitemap__grid">
                {% if categories %}
                <div class="sitemap__col">
                    <h2 class="sitemap__col-title">{{ text_catalog ?: 'Каталог' }}</h2>
                    <ul class="sitemap__list">
                        {% for category_1 in categories %}
                            <li>
                                <a href="{{ category_1.href }}">{{ category_1.name }}</a>
                                {% if category_1.children %}
                                    <ul class="sitemap__sub">
                                        {% for category_2 in category_1.children %}
                                            <li><a href="{{ category_2.href }}">{{ category_2.name }}</a></li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}

                <div class="sitemap__col">
                    <h2 class="sitemap__col-title">{{ text_account }}</h2>
                    <ul class="sitemap__list">
                        <li><a href="{{ account }}">{{ text_account }}</a></li>
                        <li><a href="{{ edit }}">{{ text_edit }}</a></li>
                        <li><a href="{{ password }}">{{ text_password }}</a></li>
                        <li><a href="{{ address }}">{{ text_address }}</a></li>
                        <li><a href="{{ history }}">{{ text_history }}</a></li>
                        <li><a href="{{ download }}">{{ text_download }}</a></li>
                    </ul>

                    <h2 class="sitemap__col-title">{{ text_special ?: 'Акції' }}</h2>
                    <ul class="sitemap__list">
                        <li><a href="{{ special }}">{{ text_special }}</a></li>
                        <li><a href="{{ blog }}">{{ text_nav_blog ?: 'Блог' }}</a></li>
                        <li><a href="{{ search }}">{{ text_search }}</a></li>
                        <li><a href="{{ checkout }}">{{ text_checkout }}</a></li>
                    </ul>
                </div>

                {% if informations %}
                <div class="sitemap__col">
                    <h2 class="sitemap__col-title">{{ text_information }}</h2>
                    <ul class="sitemap__list">
                        {% for information in informations %}
                            <li><a href="{{ information.href }}">{{ information.title }}</a></li>
                        {% endfor %}
                        {% if contact %}<li><a href="{{ contact }}">{{ text_contact }}</a></li>{% endif %}
                    </ul>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{{ content_bottom }}
{{ footer }}
