{% import _self as ui %}
{{ header }}
{{ content_top }}
<main class="od-scope">
  <div class="od-container">

    <!-- HERO -->
    <section class="od-hero">
      <nav class="od-hero__crumbs kk-reveal">
        {% for breadcrumb in breadcrumbs %}
          {% if not loop.last %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a> / {% else %}<span>{{ breadcrumb.text }}</span>{% endif %}
        {% endfor %}
      </nav>
      <h1 class="od-hero__title kk-reveal" data-delay="80">{{ heading_title }}</h1>
      <p class="od-hero__lead kk-reveal" data-delay="160">{{ text_intro }}</p>
      {% if text_free_badge %}
      <div class="od-hero__badge kk-reveal" data-delay="240">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
        {{ text_free_badge }}
      </div>
      {% endif %}
    </section>

    <!-- ОПЛАТА -->
    {% if payment_methods %}
    <section class="od-section">
      <div class="od-section__head kk-reveal">
        <h2 class="od-section__title">{{ text_payment }}</h2>
        {% if text_payment_sub %}<p class="od-section__sub">{{ text_payment_sub }}</p>{% endif %}
      </div>
      <div class="od-grid">
        {% for method in payment_methods %}
          <article class="od-card kk-reveal" data-delay="{{ loop.index0 * 80 }}">
            <div class="od-card__icon">{{ ui.odIcon(method.icon) }}</div>
            <h3 class="od-card__title">{{ method.title }}</h3>
            <p class="od-card__text">{{ method.text }}</p>
            {% if method.tag %}<span class="od-card__tag">{{ method.tag }}</span>{% endif %}
          </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- ДОСТАВКА -->
    {% if delivery_methods %}
    <section class="od-section">
      <div class="od-section__head kk-reveal">
        <h2 class="od-section__title">{{ text_delivery }}</h2>
        {% if text_delivery_sub %}<p class="od-section__sub">{{ text_delivery_sub }}</p>{% endif %}
      </div>
      <div class="od-grid">
        {% for method in delivery_methods %}
          <article class="od-card kk-reveal" data-delay="{{ loop.index0 * 80 }}">
            <div class="od-card__icon">{{ ui.odIcon(method.icon) }}</div>
            <h3 class="od-card__title">{{ method.title }}</h3>
            <p class="od-card__text">{{ method.text }}</p>
            {% if method.tag %}<span class="od-card__tag">{{ method.tag }}</span>{% endif %}
          </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- ЯК ПРАЦЮЄ -->
    {% if steps %}
    <section class="od-section">
      <div class="od-section__head kk-reveal">
        <h2 class="od-section__title">{{ text_steps_title }}</h2>
        {% if text_steps_sub %}<p class="od-section__sub">{{ text_steps_sub }}</p>{% endif %}
      </div>
      <div class="od-steps">
        {% for step in steps %}
          <div class="od-step kk-reveal" data-delay="{{ loop.index0 * 80 }}">
            <div class="od-step__num">{{ '%02d'|format(loop.index) }}</div>
            <h4 class="od-step__title">{{ step.title }}</h4>
            <p class="od-step__text">{{ step.text }}</p>
          </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- INFO -->
    {% if text_info_title %}
    <section class="od-section">
      <div class="od-info kk-reveal">
        <div class="od-info__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 2"/></svg>
        </div>
        <div class="od-info__body">
          <h3>{{ text_info_title }}</h3>
          <p>{{ text_info_text }}</p>
        </div>
      </div>
    </section>
    {% endif %}

    <!-- FAQ -->
    {% if faqs %}
    <section class="od-section">
      <div class="od-section__head kk-reveal">
        <h2 class="od-section__title">{{ text_faq_title }}</h2>
      </div>
      <div class="od-faq">
        {% for faq in faqs %}
          <div class="od-faq__item kk-reveal" data-delay="{{ loop.index0 * 60 }}">
            <button class="od-faq__q" type="button">
              {{ faq.question }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </button>
            <div class="od-faq__a"><div class="od-faq__a-inner">{{ faq.answer|raw }}</div></div>
          </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- CTA -->
    {% if text_cta_title %}
    <section class="od-container">
      <div class="od-cta kk-reveal">
        <h3 class="od-cta__title">{{ text_cta_title }}</h3>
        <p class="od-cta__text">{{ text_cta_text }}</p>
        {% if telephone %}
        <a class="od-btn" href="tel:{{ telephone|replace({' ':'','(':'',')':'','-':''}) }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0122 16.92z"/></svg>
          {{ telephone }}
        </a>
        {% endif %}
      </div>
    </section>
    {% endif %}

  </div>
</main>

{% if faqs %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for faq in faqs %}{"@type":"Question","name":"{{ faq.question|e('js') }}","acceptedAnswer":{"@type":"Answer","text":"{{ faq.answer|striptags|e('js') }}"}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}

<script>
(function(){
  document.querySelectorAll('.od-faq__item').forEach(function(item){
    var q = item.querySelector('.od-faq__q');
    var a = item.querySelector('.od-faq__a');
    if(!q||!a) return;
    q.addEventListener('click', function(){
      var open = item.classList.toggle('is-open');
      a.style.maxHeight = open ? a.scrollHeight + 'px' : '0px';
    });
  });
})();
</script>
{{ content_bottom }}
{{ footer }}

{% macro odIcon(name) %}
{% if name == 'online' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/></svg>
{% elseif name == 'card' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18l-2 12H5L3 7z"/><path d="M8 7V5a4 4 0 018 0v2"/></svg>
{% elseif name == 'invoice' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
{% elseif name == 'pickup' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><path d="M9 22V12h6v10"/></svg>
{% elseif name == 'nova_poshta' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="6" width="15" height="12" rx="2"/><path d="M16 10h4l3 3v5h-7"/><circle cx="6" cy="20" r="2"/><circle cx="18" cy="20" r="2"/></svg>
{% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
{% endif %}
{% endmacro %}
